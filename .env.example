# Publish a Google Sheet tab as CSV and paste the CSV URL here.
# Required columns: start_date,end_date,room_type,rate_npr,available_rooms
GOOGLE_SHEET_CSV_URL=

# Set only in Vercel Production to show the holding page. Leave unset in Preview.
SITE_MODE=

# Optional public destinations. Missing links remain hidden.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_AIRBNB_URL=
NEXT_PUBLIC_MAP_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only to label the approximate USD guide. Update when your sheet rates change.
NEXT_PUBLIC_NPR_PER_USD=140
NEXT_PUBLIC_EXCHANGE_RATE_DATE=2026-08-02

# Visual CMS authentication. Generate a unique salt, scrypt hash, and 32+ character session secret.
# Never place the plaintext password in an environment file.
CMS_USERNAME=hhbedit
CMS_PASSWORD_SALT=
CMS_PASSWORD_HASH=
CMS_SESSION_SECRET=

# Create two Vercel Blob stores: Private for content/revisions and Public for uploaded images.
CMS_READ_WRITE_TOKEN=
CMS_MEDIA_READ_WRITE_TOKEN=
